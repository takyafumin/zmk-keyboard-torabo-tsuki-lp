#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&caps_word { continue-list = <UNDERSCORE BACKSPACE DELETE MINUS>; };

&msc { acceleration-exponent = <3>; };

// マウスキーを押した後、200mでbase layerに戻る(ダブルクリック猶予)

&mkp_input_listener {
    input-processors = <
        &zip_temp_layer 4 200
    >;
};

/ {
    combos {
        compatible = "zmk,combos";

        prev {
            bindings = <&mkp MB4>;
            key-positions = <19 33>;
        };

        next {
            bindings = <&mkp MB5>;
            key-positions = <20 34>;
        };

        left-click {
            bindings = <&mkp LCLK>;
            key-positions = <16 28>;
        };

        right-click {
            bindings = <&mkp RCLK>;
            key-positions = <15 27>;
        };

        en {
            bindings = <&kp LANGUAGE_2>;
            key-positions = <19 20>;
        };

        jp {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <20 21>;
        };
    };

    behaviors {
        hold_preferred: hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <180>;
            flavor = "hold-preferred";
        };

        layer_hold_priority: layer_hold_priority {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOLD_PRIORITY";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            hold-while-undecided;
        };

        tap_preferred: tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
            quick-tap-ms = <180>;
        };

        layer_tap_preferred: layer_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_PREFERRED";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&none  &none                                    &none                          &none                       &none                          &none                                                                                     &none                         &none                         &none                       &none                           &none                                        &none
&none  &kp Q                                    &kp W                          &kp E                       &kp R                          &kp T                                                                                     &kp Y                         &kp U                         &kp I                       &kp O                           &kp P                                        &none
&none  &tap_preferred LCTRL A                   &tap_preferred LEFT_COMMAND S  &tap_preferred RIGHT_ALT D  &tap_preferred LEFT_SHIFT F    &kp G                         &none                         &none                         &kp H                         &tap_preferred RIGHT_SHIFT J  &tap_preferred RIGHT_ALT K  &tap_preferred RIGHT_COMMAND L  &hold_preferred LEFT_CONTROL MINUS           &none
&none  &tap_preferred RA(LC(LG(LEFT_SHIFT))) Z  &kp X                          &kp C                       &layer_tap_preferred 8 V       &kp B                         &mo 7                         &kp LG(LS(NUMBER_4))          &kp N                         &layer_tap_preferred 8 M      &kp COMMA                   &kp PERIOD                      &hold_preferred RA(LC(LG(LEFT_SHIFT))) FSLH  &none
&none  &mo 4                                    &mo 6                          &kp LG(LS(NUMBER_4))        &layer_hold_priority 7 ESCAPE  &layer_hold_priority 1 LANG2  &layer_hold_priority 5 SPACE  &hold_preferred RSHIFT ENTER  &layer_hold_priority 2 LANG1  &none                         &none                       &mo 6                           &mo 4                                        &none
            >;

            label = "base";
        };

        marks {
            bindings = <
&trans  &trans                                         &trans                             &trans                          &trans                           &trans                                 &trans                      &trans                           &trans                             &trans                              &trans                                           &trans
&trans  &kp EXCL                                       &kp AT                             &kp HASH                        &kp DOLLAR                       &kp PERCENT                            &kp CARET                   &kp AMPERSAND                    &kp ASTERISK                       &kp LEFT_PARENTHESIS                &kp RIGHT_PARENTHESIS                            &trans
&trans  &tap_preferred LCTRL TAB                       &tap_preferred LEFT_COMMAND GRAVE  &tap_preferred RIGHT_ALT EQUAL  &tap_preferred LEFT_SHIFT COLON  &kp BACKSLASH  &trans  &trans          &kp LEFT                    &tap_preferred RIGHT_SHIFT DOWN  &tap_preferred RIGHT_ALT UP_ARROW  &tap_preferred RIGHT_COMMAND RIGHT  &tap_preferred RCTRL UNDERSCORE                  &trans
&trans  &hold_preferred RA(LC(LG(LEFT_SHIFT))) ESCAPE  &kp TILDE                          &kp PLUS                        &kp SEMI                         &kp PIPE       &trans  &trans          &kp EQUAL                   &kp SINGLE_QUOTE                 &kp LESS_THAN                      &kp GREATER_THAN                    &hold_preferred RA(LC(LG(LEFT_SHIFT))) QUESTION  &trans
&trans  &trans                                         &trans                             &trans                          &trans                           &trans         &trans  &sk LEFT_SHIFT  &layer_hold_priority 3 TAB  &trans                           &trans                             &trans                              &kp DELETE                                       &trans
            >;
        };

        nums {
            bindings = <
&trans  &trans                                        &trans                             &trans                                 &trans                                   &trans                                             &trans         &trans                              &trans                       &trans                            &trans                                        &trans
&trans  &kp NUMBER_1                                  &kp NUMBER_2                       &kp N3                                 &kp N4                                   &kp N5                                             &kp N6         &kp N7                              &kp N8                       &kp N9                            &kp N0                                        &trans
&trans  &tap_preferred LCTRL TAB                      &tap_preferred LEFT_COMMAND GRAVE  &tap_preferred RIGHT_ALT LEFT_BRACKET  &tap_preferred LEFT_SHIFT RIGHT_BRACKET  &kp EQUAL                  &trans          &trans  &kp BACKSLASH  &tap_preferred LEFT_SHIFT NUMBER_4  &tap_preferred RIGHT_ALT N5  &tap_preferred LEFT_GUI NUMBER_6  &tap_preferred LCTRL MINUS                    &trans
&trans  &tap_preferred LA(LC(LG(LEFT_SHIFT))) ESCAPE  &kp TILDE                          &kp LEFT_BRACE                         &kp RIGHT_BRACE                          &kp PLUS                   &trans          &trans  &kp PIPE       &kp NUMBER_1                        &kp NUMBER_2                 &kp NUMBER_3                      &tap_preferred LS(LA(LC(LEFT_COMMAND))) PLUS  &trans
&trans  &trans                                        &trans                             &trans                                 &trans                                   &layer_hold_priority 3 N0  &sk LEFT_SHIFT  &trans  &trans         &trans                              &trans                       &trans                            &trans                                        &trans
            >;
        };

        extra {
            bindings = <
&trans  &trans        &trans        &trans         &trans          &trans                  &trans    &trans         &trans       &trans   &trans   &trans
&trans  &kp F1        &kp F2        &kp F3         &kp F4          &kp F5                  &kp F6    &kp F7         &kp F8       &kp F9   &kp F10  &trans
&trans  &sk LCTRL     &sk LEFT_WIN  &sk RIGHT_ALT  &sk LEFT_SHIFT  &trans  &trans  &trans  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END  &trans   &trans
&trans  &kp CAPSLOCK  &trans        &trans         &trans          &trans  &trans  &trans  &trans    &kp F11        &kp F12      &trans   &trans   &trans
&trans  &trans        &trans        &trans         &trans          &trans  &trans  &trans  &trans    &trans         &trans       &trans   &trans   &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        MOUSE-scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &bt BT_PRV    &bt BT_NXT    &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        numpad {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                        &trans     &trans        &trans  &trans  &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                        &trans     &kp N7        &kp N8  &kp N9  &kp ASTERISK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &kp EQUAL  &kp NUMBER_4  &kp N5  &kp N6  &kp MINUS     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &kp PLUS   &kp N1        &kp N2  &kp N3  &kp SLASH     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp SPACE  &kp ENTER  &kp N0     &trans        &trans  &trans  &trans        &trans
            >;
        };

        support {
            bindings = <
&trans  &trans        &trans  &trans                &trans                 &trans                  &trans         &trans  &trans  &trans  &trans        &trans
&trans  &kp ESCAPE    &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans                  &trans         &trans  &trans  &trans  &kp DELETE    &trans
&trans  &kp TAB       &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans  &trans  &kp BACKSPACE  &trans  &trans  &trans  &trans        &trans
&trans  &kp CAPSLOCK  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans  &trans  &trans  &trans         &trans  &trans  &trans  &kp CAPSLOCK  &trans
&trans  &trans        &trans  &trans                &trans                 &trans  &trans  &trans  &trans         &trans  &trans  &trans  &trans        &trans
            >;
        };
    };
};
