#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&caps_word { continue-list = <UNDERSCORE BACKSPACE DELETE MINUS>; };

&msc { acceleration-exponent = <2>; };

// マウスキーを押した後、200mでbase layerに戻る(ダブルクリック猶予)

&mkp_input_listener {
    input-processors = <
        &zip_temp_layer 4 300
    >;
};

/ {
    combos {
        compatible = "zmk,combos";

        esc {
            bindings = <&kp ESCAPE>;
            key-positions = <13 14>;
        };

        print-screen {
            bindings = <&kp LG(LS(NUMBER_4))>;
            key-positions = <18 19>;
            require-prior-idle-ms = <150>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <22 21>;
        };

        en {
            bindings = <&kp LANG2>;
            key-positions = <42 41>;
        };

        jp {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <47 48>;
        };

        Tab {
            bindings = <&kp TAB>;
            key-positions = <39 40>;
        };

        StickShift {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <50 49>;
        };

        WebBack {
            bindings = <&mkp MB4>;
            key-positions = <19 20>;
        };

        WebNext {
            bindings = <&mkp MB5>;
            key-positions = <20 21>;
        };
    };

    behaviors {
        hold_preferred: hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "hold-preferred";
        };

        layer_hold_priority: layer_hold_priority {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOLD_PRIORITY";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            hold-while-undecided;
        };

        tap_preferred: tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
            quick-tap-ms = <180>;
        };

        layer_tap_preferred: layer_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_PREFERRED";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };
    };

    macros {
        esc_en: esc_en {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp ESC &kp LANG1>;
            label = "ESC_EN";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&none  &none                                    &none                          &none                       &none                        &none                                                                  &none                         &none                         &none                       &none                           &none                                       &none
&none  &kp Q                                    &kp W                          &kp E                       &kp R                        &kp T                                                                  &kp Y                         &kp U                         &kp I                       &kp O                           &kp P                                       &none
&none  &tap_preferred LCTRL A                   &tap_preferred LEFT_COMMAND S  &tap_preferred RIGHT_ALT D  &tap_preferred LEFT_SHIFT F  &layer_tap_preferred 7 G      &none      &none                         &kp H                         &tap_preferred RIGHT_SHIFT J  &tap_preferred RIGHT_ALT K  &tap_preferred RIGHT_COMMAND L  &hold_preferred LEFT_CONTROL MINUS          &none
&none  &tap_preferred RA(LC(LG(LEFT_SHIFT))) Z  &kp X                          &kp C                       &layer_tap_preferred 5 V     &kp B                         &mo 7      &sk LEFT_SHIFT                &kp N                         &layer_tap_preferred 8 M      &kp COMMA                   &kp PERIOD                      &tap_preferred RA(LC(LG(LEFT_SHIFT))) FSLH  &none
&none  &mo 5                                    &mo 6                          &kp LG(LS(NUMBER_4))        &kp ESCAPE                   &layer_hold_priority 1 LANG2  &kp SPACE  &hold_preferred RSHIFT ENTER  &layer_hold_priority 2 LANG1  &none                         &none                       &mo 6                           &mo 5                                       &none
            >;

            label = "base";
        };

        marks {
            bindings = <
&trans  &trans                    &trans                             &trans                          &trans                           &trans                                     &trans                      &trans                           &trans                             &trans                              &trans                                          &trans
&trans  &kp EXCL                  &kp AT                             &kp HASH                        &kp DOLLAR                       &kp PERCENT                                &kp CARET                   &kp AMPERSAND                    &kp ASTERISK                       &kp LEFT_PARENTHESIS                &kp RIGHT_PARENTHESIS                           &trans
&trans  &tap_preferred LCTRL TAB  &tap_preferred LEFT_COMMAND GRAVE  &tap_preferred RIGHT_ALT EQUAL  &tap_preferred LEFT_SHIFT COLON  &kp SINGLE_QUOTE   &trans  &trans          &kp LEFT                    &tap_preferred RIGHT_SHIFT DOWN  &tap_preferred RIGHT_ALT UP_ARROW  &tap_preferred RIGHT_COMMAND RIGHT  &tap_preferred RCTRL UNDERSCORE                 &trans
&trans  &trans                    &kp TILDE                          &kp PLUS                        &kp SEMI                         &kp DOUBLE_QUOTES  &trans  &trans          &kp BACKSPACE               &kp ENTER                        &kp LESS_THAN                      &kp GREATER_THAN                    &tap_preferred RA(LC(LG(LEFT_SHIFT))) QUESTION  &trans
&trans  &trans                    &trans                             &trans                          &trans                           &trans             &trans  &sk LEFT_SHIFT  &layer_hold_priority 3 TAB  &trans                           &trans                             &trans                              &kp DELETE                                      &trans
            >;
        };

        nums {
            bindings = <
&trans  &trans                    &trans                             &trans                                 &trans                                   &trans                                             &trans     &trans                                  &trans  &trans  &trans                                        &trans
&trans  &kp NUMBER_1              &kp NUMBER_2                       &kp N3                                 &kp N4                                   &kp N5                                             &kp N6     &kp N7                                  &kp N8  &kp N9  &kp N0                                        &trans
&trans  &tap_preferred LCTRL TAB  &tap_preferred LEFT_COMMAND GRAVE  &tap_preferred RIGHT_ALT LEFT_BRACKET  &tap_preferred LEFT_SHIFT RIGHT_BRACKET  &trans                     &trans          &trans  &kp EQUAL  &tap_preferred LEFT_SHIFT SINGLE_QUOTE  &trans  &trans  &tap_preferred LCTRL BACKSLASH                &trans
&trans  &trans                    &kp TILDE                          &kp LEFT_BRACE                         &kp RIGHT_BRACE                          &trans                     &trans          &trans  &kp PLUS   &kp DOUBLE_QUOTES                       &trans  &trans  &tap_preferred LS(LA(LC(LEFT_COMMAND))) PIPE  &trans
&trans  &trans                    &trans                             &trans                                 &trans                                   &layer_hold_priority 3 N0  &sk LEFT_SHIFT  &trans  &trans     &trans                                  &trans  &trans  &trans                                        &trans
            >;
        };

        extra {
            bindings = <
&trans  &trans        &trans  &trans  &trans  &trans                  &trans    &trans         &trans       &trans   &trans   &trans
&trans  &kp F1        &kp F2  &kp F3  &kp F4  &kp F5                  &kp F6    &kp F7         &kp F8       &kp F9   &kp F10  &trans
&trans  &kp CAPSLOCK  &trans  &trans  &trans  &trans  &trans  &trans  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END  &trans   &trans
&trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &kp F11        &kp F12      &trans   &trans   &trans
&trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans         &trans       &trans   &trans   &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &mkp RCLK  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &trans  &trans  &trans
            >;
        };

        MOUSE-scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &bt BT_PRV    &bt BT_NXT    &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        numpad {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                        &trans     &trans        &trans  &trans  &trans        &trans
&trans  &trans  &trans  &trans  &trans  &trans                        &trans     &kp N7        &kp N8  &kp N9  &kp ASTERISK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &kp EQUAL  &kp NUMBER_4  &kp N5  &kp N6  &kp MINUS     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans     &kp PLUS   &kp N1        &kp N2  &kp N3  &kp SLASH     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &kp SPACE  &kp ENTER  &kp N0     &trans        &trans  &trans  &trans        &trans
            >;
        };

        kakko {
            bindings = <
&trans  &trans  &trans  &trans                &trans                 &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans                &trans                 &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };
    };
};
