#include <input/processors.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&caps_word { continue-list = <UNDERSCORE BACKSPACE DELETE MINUS>; };

&msc { acceleration-exponent = <0>; };

// マウスキーを押した後、200mでbase layerに戻る(ダブルクリック猶予)

&mkp_input_listener {
    input-processors = <
        &zip_temp_layer 4 200
    >;
};

/ {
    combos {
        compatible = "zmk,combos";

        jp-right {
            bindings = <&kp LANGUAGE_1>;
            key-positions = <34 33>;
        };

        en-left {
            bindings = <&kp LANG2>;
            key-positions = <27 28>;
        };

        capslock {
            bindings = <&kp CAPS>;
            key-positions = <49 48>;
        };
    };

    behaviors {
        hold_preferred: hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <180>;
            flavor = "hold-preferred";
        };

        layer_hold_priority: layer_hold_priority {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOLD_PRIORITY";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            hold-while-undecided;
        };

        tap_preferred: tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <125>;
            quick-tap-ms = <180>;
        };

        layer_tap_preferred: layer_tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_PREFERRED";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            quick-tap-ms = <0>;
            require-prior-idle-ms = <125>;
            flavor = "tap-preferred";
        };

        tap_dance_lang: tap_dance_lang {
            compatible = "zmk,behavior-tap-dance";
            label = "TAP_DANCE_LANG";
            #binding-cells = <0>;
            bindings = <&kp LANG2>, <&kp LANG1>;

            tapping-term-ms = <180>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&none  &none                          &none                          &none                          &none                          &none                                                                                             &none                              &none                       &none                          &none                           &none                             &none
&none  &tap_preferred ESCAPE Q        &kp W                          &kp E                          &kp R                          &kp T                                                                                             &kp Y                              &kp U                       &kp I                          &kp O                           &tap_preferred LS(LG(N4)) P       &none
&none  &tap_preferred LEFT_SHIFT A    &tap_preferred LEFT_COMMAND S  &tap_preferred LEFT_CONTROL D  &tap_preferred RIGHT_ALT F     &kp G                              &none                            &none                         &kp H                              &tap_preferred RIGHT_ALT J  &tap_preferred LEFT_CONTROL K  &tap_preferred RIGHT_COMMAND L  &hold_preferred LEFT_SHIFT MINUS  &none
&none  &layer_tap_preferred 7 Z       &kp X                          &kp C                          &layer_tap_preferred 7 V       &kp B                              &kp LG(LS(N4))                   &mkp RCLK                     &kp N                              &kp M                       &kp COMMA                      &kp PERIOD                      &kp SLASH                         &none
&none  &layer_hold_priority 7 ESCAPE  &mkp RCLK                      &mkp LCLK                      &layer_hold_priority 7 ESCAPE  &layer_hold_priority 1 LANGUAGE_2  &tap_preferred LEFT_SHIFT SPACE  &hold_preferred RSHIFT ENTER  &layer_hold_priority 2 LANGUAGE_1  &none                       &none                          &mo 6                           &kp TAB                           &none
            >;

            label = "base";
        };

        marks {
            bindings = <
&trans  &trans          &trans            &trans            &trans                      &trans                              &trans                      &trans                         &trans                                &trans                              &trans                          &trans
&trans  &kp EXCL        &kp AT            &kp HASH          &kp DOLLAR                  &kp PERCENT                         &kp CARET                   &kp AMPERSAND                  &kp ASTERISK                          &kp LEFT_PARENTHESIS                &kp RIGHT_PARENTHESIS           &trans
&trans  &sk LEFT_SHIFT  &kp LEFT_COMMAND  &kp LEFT_CONTROL  &kp RIGHT_ALT               &kp GRAVE    &trans  &trans         &kp LEFT                    &tap_preferred RIGHT_ALT DOWN  &tap_preferred LEFT_CONTROL UP_ARROW  &tap_preferred RIGHT_COMMAND RIGHT  &tap_preferred LEFT_SHIFT SEMI  &trans
&trans  &kp ESCAPE      &trans            &trans            &sk LA(LC(LG(LEFT_SHIFT)))  &kp TILDE    &trans  &trans         &kp EQUAL                   &kp SINGLE_QUOTE               &kp LEFT_BRACKET                      &kp RIGHT_BRACKET                   &kp BACKSLASH                   &trans
&trans  &trans          &trans            &trans            &trans                      &trans       &trans  &kp BACKSPACE  &layer_hold_priority 3 TAB  &trans                         &trans                                &trans                              &kp DELETE                      &trans
            >;
        };

        nums {
            bindings = <
&trans  &trans          &trans            &trans            &trans         &trans                                     &trans     &trans                             &trans                          &trans                            &trans                           &trans
&trans  &kp NUMBER_1    &kp NUMBER_2      &kp N3            &kp N4         &kp N5                                     &kp N6     &kp N7                             &kp N8                          &kp N9                            &kp N0                           &trans
&trans  &sk LEFT_SHIFT  &sk LEFT_COMMAND  &sk LEFT_CONTROL  &sk RIGHT_ALT  &trans                     &trans  &trans  &kp PLUS   &tap_preferred RIGHT_ALT NUMBER_4  &tap_preferred LEFT_CONTROL N5  &tap_preferred LEFT_GUI NUMBER_6  &tap_preferred LEFT_SHIFT MINUS  &trans
&trans  &kp LANGUAGE_2  &trans            &trans            &trans         &trans                     &trans  &trans  &kp ASTRK  &kp NUMBER_1                       &kp NUMBER_2                    &kp NUMBER_3                      &kp LANGUAGE_1                   &trans
&trans  &trans          &trans            &trans            &trans         &layer_hold_priority 3 N0  &trans  &trans  &trans     &trans                             &trans                          &trans                            &trans                           &trans
            >;
        };

        extra {
            bindings = <
&trans  &trans        &trans        &trans            &trans         &trans                  &trans    &trans         &trans       &trans   &trans                &trans
&trans  &kp F1        &kp F2        &kp F3            &kp F4         &kp F5                  &kp F6    &kp F7         &kp F8       &kp F9   &kp F10               &trans
&trans  &sk RSHFT     &sk LEFT_WIN  &sk LEFT_CONTROL  &sk RIGHT_ALT  &trans  &trans  &trans  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END  &kp LG(LS(NUMBER_4))  &trans
&trans  &kp CAPSLOCK  &trans        &trans            &trans         &trans  &trans  &trans  &trans    &kp F11        &kp F12      &trans   &trans                &trans
&trans  &trans        &trans        &trans            &trans         &trans  &trans  &trans  &trans    &trans         &trans       &trans   &trans                &trans
            >;
        };

        mouse-scroll-support {
            bindings = <
&trans  &trans        &trans  &trans  &trans  &trans                  &trans         &trans     &trans     &trans  &trans        &trans
&trans  &kp ESCAPE    &trans  &trans  &trans  &trans                  &trans         &trans     &trans     &trans  &kp DELETE    &trans
&trans  &kp TAB       &trans  &trans  &trans  &trans  &trans  &trans  &kp BACKSPACE  &trans     &trans     &trans  &kp ENTER     &trans
&trans  &kp CAPSLOCK  &trans  &trans  &trans  &trans  &trans  &trans  &trans         &kp LANG2  &kp LANG1  &trans  &trans        &trans
&trans  &trans        &trans  &trans  &trans  &trans  &trans  &trans  &kp SPACE      &trans     &trans     &trans  &kp CAPSLOCK  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans     &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp LCLK  &trans  &trans     &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &mkp RCLK  &mkp RCLK  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &trans     &trans     &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_CLR    &trans        &trans        &bt BT_PRV    &bt BT_NXT    &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        arrow {
            bindings = <
&trans  &trans                  &trans  &trans  &trans                      &trans                  &trans          &trans                     &trans                             &trans                             &trans  &trans
&trans  &trans                  &trans  &trans  &trans                      &trans                  &trans          &trans                     &trans                             &trans                             &trans  &trans
&trans  &trans                  &trans  &trans  &trans                      &trans  &trans  &trans  &kp LEFT_ARROW  &tap_preferred RSHFT DOWN  &tap_preferred RIGHT_ALT UP_ARROW  &tap_preferred LEFT_CONTROL RIGHT  &trans  &trans
&trans  &sk LA(LC(LG(LSHIFT)))  &trans  &trans  &sk LA(LC(LG(LSHFT)))       &trans  &trans  &trans  &kp HOME        &kp PAGE_DOWN              &kp PAGE_UP                        &kp END                            &trans  &trans
&trans  &trans                  &trans  &trans  &kp LA(LC(LG(LEFT_SHIFT)))  &trans  &trans  &trans  &trans          &trans                     &trans                             &trans                             &trans  &trans
            >;
        };
    };
};
