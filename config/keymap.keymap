#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

&caps_word { continue-list = <UNDERSCORE BACKSPACE DELETE MINUS>; };

&msc { acceleration-exponent = <2>; };

/ {
    combos {
        compatible = "zmk,combos";

        print-screen {
            bindings = <&kp LG(LS(NUMBER_4))>;
            key-positions = <22 36>;
            require-prior-idle-ms = <150>;
        };

        escape {
            bindings = <&kp ESCAPE>;
            key-positions = <13 25>;
        };

        backspace {
            bindings = <&kp BACKSPACE>;
            key-positions = <32 33>;
        };

        scroll-layer {
            bindings = <&mo 5>;
            key-positions = <28 16>;
        };

        mouse-layer {
            bindings = <&mo 6>;
            key-positions = <28 42>;
        };

        sticky-lshift {
            bindings = <&sk LEFT_SHIFT>;
            key-positions = <25 39>;
        };

        sticky-rshift {
            bindings = <&sk RIGHT_SHIFT>;
            key-positions = <33 47>;
        };
    };

    behaviors {
        hold_preferred: hold_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "HOLD_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            flavor = "hold-preferred";
        };

        layer_hold_priority: layer_hold_priority {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_HOLD_PRIORITY";
            bindings = <&mo>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            hold-while-undecided;
        };

        balanced: balanced {
            compatible = "zmk,behavior-hold-tap";
            label = "BALANCED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "balanced";
            quick-tap-ms = <180>;
        };

        tap_preferred: tap_preferred {
            compatible = "zmk,behavior-hold-tap";
            label = "TAP_PREFERRED";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <180>;
            flavor = "tap-preferred";
            require-prior-idle-ms = <180>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
&none  &none                        &none                          &none                       &none                          &none                                                                  &none                         &none                         &none                       &none                           &none                               &none
&none  &kp Q                        &kp W                          &kp E                       &kp R                          &kp T                                                                  &kp Y                         &kp U                         &kp I                       &kp O                           &kp P                               &none
&none  &tap_preferred LCTRL A       &tap_preferred LEFT_COMMAND S  &tap_preferred RIGHT_ALT D  &tap_preferred LEFT_SHIFT F    &kp G                         &none      &none                         &kp H                         &tap_preferred RIGHT_SHIFT J  &tap_preferred RIGHT_ALT K  &tap_preferred RIGHT_COMMAND L  &hold_preferred LEFT_CONTROL MINUS  &none
&none  &tap_preferred LEFT_SHIFT Z  &kp X                          &kp C                       &layer_hold_priority 8 V       &kp B                         &mo 3      &tog 6                        &kp N                         &layer_hold_priority 8 M      &kp COMMA                   &kp PERIOD                      &tap_preferred LEFT_SHIFT FSLH      &none
&none  &mo 6                        &mo 7                          &mo 6                       &layer_hold_priority 2 ESCAPE  &layer_hold_priority 1 LANG2  &kp SPACE  &hold_preferred RSHIFT ENTER  &layer_hold_priority 2 LANG1  &none                         &none                       &mo 7                           &mo 6                               &none
            >;

            label = "base";
        };

        marks {
            bindings = <
&trans  &trans                      &trans                                 &trans                          &trans                           &trans                                                      &trans                      &trans                           &trans                             &trans                              &trans                              &trans
&trans  &kp EXCL                    &kp AT                                 &kp HASH                        &kp DOLLAR                       &kp PERCENT                                                 &kp CARET                   &kp AMPERSAND                    &kp ASTERISK                       &kp LEFT_PARENTHESIS                &kp RIGHT_PARENTHESIS               &trans
&trans  &tap_preferred LCTRL TAB    &tap_preferred LEFT_COMMAND BACKSLASH  &tap_preferred RIGHT_ALT GRAVE  &tap_preferred LEFT_SHIFT COLON  &kp BACKSLASH  &trans  &trans                               &kp LEFT                    &tap_preferred RIGHT_SHIFT DOWN  &tap_preferred RIGHT_ALT UP_ARROW  &tap_preferred RIGHT_COMMAND RIGHT  &tap_preferred RCTRL UNDERSCORE     &trans
&trans  &sk LA(LC(LG(LEFT_SHIFT)))  &kp PIPE                               &kp TILDE                       &kp SEMICOLON                    &kp PIPE       &trans  &trans                               &kp EQUAL                   &kp SINGLE_QUOTE                 &kp LESS_THAN                      &kp GREATER_THAN                    &tap_preferred LEFT_SHIFT QUESTION  &trans
&trans  &trans                      &trans                                 &trans                          &trans                           &trans         &trans  &tap_preferred LEFT_SHIFT BACKSPACE  &layer_hold_priority 4 TAB  &trans                           &trans                             &trans                              &kp DELETE                          &trans
            >;
        };

        nums {
            bindings = <
&trans  &trans                    &trans        &trans          &trans          &trans                                     &trans    &trans                          &trans                             &trans                         &trans  &trans
&trans  &kp NUMBER_1              &kp NUMBER_2  &kp N3          &kp N4          &kp N5                                     &kp N6    &kp N7                          &kp N8                             &kp N9                         &kp N0  &trans
&trans  &tap_preferred LCTRL TAB  &trans        &kp LANGUAGE_1  &kp LANG2       &trans                     &trans  &trans  &kp LEFT  &tap_preferred LEFT_SHIFT DOWN  &tap_preferred RIGHT_ALT UP_ARROW  &tap_preferred LEFT_WIN RIGHT  &trans  &trans
&trans  &kp ESCAPE                &trans        &trans          &sk LEFT_SHIFT  &trans                     &trans  &trans  &trans    &sk LEFT_SHIFT                  &trans                             &trans                         &trans  &trans
&trans  &trans                    &trans        &trans          &trans          &layer_hold_priority 4 N0  &trans  &trans  &trans    &trans                          &trans                             &trans                         &trans  &trans
            >;
        };

        numpad {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                     &trans  &trans        &trans  &trans  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans                     &trans  &kp N7        &kp N8  &kp N9  &kp EQUAL  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &kp NUMBER_4  &kp N5  &kp N6  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans     &trans  &kp N1        &kp N2  &kp N3  &trans     &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &kp EQUAL  &kp N0  &trans        &trans  &trans  &trans     &trans
            >;
        };

        extra {
            bindings = <
&trans  &trans        &trans  &trans  &trans  &trans                          &trans    &trans         &trans       &trans   &trans      &trans
&trans  &kp F1        &kp F2  &kp F3  &kp F4  &kp F5                          &kp F6    &kp F7         &kp F8       &kp F9   &kp F10     &trans
&trans  &kp CAPSLOCK  &trans  &trans  &trans  &trans  &trans          &trans  &kp HOME  &kp PAGE_DOWN  &kp PAGE_UP  &kp END  &trans      &trans
&trans  &trans        &trans  &trans  &trans  &trans  &bt BT_CLR_ALL  &trans  &trans    &kp F11        &kp F12      &trans   &trans      &trans
&trans  &bt BT_NXT    &trans  &trans  &trans  &trans  &trans          &trans  &trans    &trans         &trans       &trans   &bt BT_PRV  &trans
            >;
        };

        my-scroll {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        mouse {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                  &trans    &trans     &trans     &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                  &trans    &trans     &trans     &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &mkp MB4  &mkp LCLK  &mkp RCLK  &mkp MB5  &mo 5   &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans    &trans     &trans     &trans    &trans  &trans
&trans  &trans  &trans  &trans  &trans  &mo 5   &trans  &trans  &mo 5     &trans     &trans     &trans    &trans  &trans
            >;
        };

        bluetooth {
            bindings = <
&trans  &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans                                &trans  &trans  &trans  &trans  &trans  &trans
&trans  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &trans        &trans        &bt BT_CLR_ALL  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans        &trans        &trans        &bt BT_PRV    &bt BT_NXT    &trans          &trans  &trans  &trans  &trans  &trans  &trans  &trans
            >;
        };

        kakko {
            bindings = <
&trans  &trans  &trans  &trans                &trans                 &trans                  &trans  &trans                &trans                 &trans  &trans  &trans
&trans  &trans  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans                  &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &trans  &trans  &trans
&trans  &trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans  &trans  &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &trans  &trans  &trans
&trans  &trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans  &trans  &trans  &trans  &kp LEFT_BRACE        &kp RIGHT_BRACE        &trans  &trans  &trans
&trans  &trans  &trans  &trans                &trans                 &trans  &trans  &trans  &trans  &trans                &trans                 &trans  &trans  &trans
            >;
        };
    };
};
